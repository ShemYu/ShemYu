<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ basics.name }} - Detailed Resume</title>
    <style>
        :root {
            --ink: #15222e;
            --muted: #536270;
            --accent: #173f5f;
            --rule: #cbd4dc;
            --soft: #edf2f5;
        }

        * { box-sizing: border-box; }

        html, body { margin: 0; padding: 0; }

        body {
            background: #e8ecef;
            color: var(--ink);
            font-family: Arial, Helvetica, sans-serif;
            font-size: 9.8pt;
            line-height: 1.37;
            -webkit-font-smoothing: antialiased;
        }

        .resume {
            width: 210mm;
            margin: 12px auto;
            padding: 13mm 14mm;
            background: #fff;
            box-shadow: 0 2px 12px rgba(20, 32, 43, 0.14);
        }

        a { color: inherit; text-decoration: none; }

        .header {
            padding-bottom: 3.5mm;
            border-bottom: 1.4pt solid var(--accent);
        }

        h1 {
            margin: 0;
            color: var(--accent);
            font-size: 26pt;
            line-height: 1;
            letter-spacing: -0.02em;
        }

        .headline {
            margin-top: 1.4mm;
            font-size: 11.3pt;
            font-weight: 700;
        }

        .contact {
            display: flex;
            flex-wrap: wrap;
            margin-top: 1.8mm;
            color: var(--muted);
            font-size: 8.5pt;
        }

        .contact-item + .contact-item::before {
            content: " | ";
            padding: 0 1.1mm;
            color: #8996a1;
        }

        section {
            margin-top: 4mm;
        }

        h2 {
            margin: 0 0 1.8mm;
            color: var(--accent);
            font-size: 10.2pt;
            line-height: 1.1;
            letter-spacing: 0.11em;
            text-transform: uppercase;
            break-after: avoid-page;
        }

        p { margin: 0; }

        .summary {
            color: #293a49;
            font-size: 10pt;
        }

        .entry {
            margin-bottom: 3.4mm;
        }

        .entry:last-child { margin-bottom: 0; }

        .compact-entry {
            break-inside: avoid-page;
        }

        .entry-header,
        .project-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 5mm;
            break-after: avoid-page;
        }

        .entry-heading {
            min-width: 0;
            font-size: 10.7pt;
            line-height: 1.17;
        }

        .entry-title { font-weight: 700; }

        .entry-company::before {
            content: " | ";
            padding: 0 0.7mm;
            color: #83909a;
            font-weight: 400;
        }

        .entry-company {
            color: #344b5f;
            font-weight: 600;
        }

        .entry-meta,
        .project-meta {
            flex: 0 0 auto;
            color: var(--muted);
            font-size: 8.5pt;
            white-space: nowrap;
        }

        .role-summary,
        .project-summary {
            margin-top: 0.65mm;
            color: #465867;
            font-size: 9.2pt;
            font-style: italic;
            break-after: avoid-page;
        }

        ul {
            margin: 1mm 0 0;
            padding-left: 4.3mm;
        }

        li {
            margin-bottom: 0.7mm;
            padding-left: 0.45mm;
            break-inside: avoid-page;
        }

        li::marker { color: var(--accent); }
        li:last-child { margin-bottom: 0; }

        .project {
            margin-bottom: 4mm;
            break-inside: avoid-page;
        }

        .project:last-child { margin-bottom: 0; }

        .project-name {
            color: #203d54;
            font-size: 10.4pt;
            font-weight: 700;
        }

        .project-company {
            color: var(--muted);
            font-size: 8.8pt;
        }

        .project-company::before {
            content: " | ";
            padding: 0 0.6mm;
            color: #8996a1;
        }

        .tags {
            margin-top: 1mm;
            color: #3c5061;
            font-size: 8.3pt;
        }

        .tag {
            display: inline-block;
            margin: 0 0.8mm 0.7mm 0;
            padding: 0.3mm 1.3mm;
            border: 0.5pt solid #c7d2db;
            border-radius: 2mm;
            background: var(--soft);
        }

        .skill-row {
            display: grid;
            grid-template-columns: 34mm 1fr;
            column-gap: 2.5mm;
            margin-bottom: 0.8mm;
            font-size: 9pt;
            break-inside: avoid-page;
        }

        .expertise {
            break-before: page;
        }

        .skill-name {
            color: #344b5f;
            font-weight: 700;
        }

        .education,
        .credential,
        .publication {
            margin-bottom: 1.7mm;
            break-inside: avoid-page;
        }

        .education-header,
        .credential-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 5mm;
        }

        .education-main,
        .credential-main,
        .publication-main {
            font-weight: 700;
        }

        .detail { color: #405260; }

        .education ul {
            margin-top: 0.7mm;
            font-size: 9.1pt;
        }

        .recognition-list,
        .publication-list {
            margin-top: 0;
        }

        .compact-block {
            break-inside: avoid-page;
        }

        @media print {
            @page {
                size: A4;
                margin: 13mm 14mm;
            }

            body {
                background: #fff;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                orphans: 3;
                widows: 3;
            }

            .resume {
                width: auto;
                margin: 0;
                padding: 0;
                box-shadow: none;
            }

        }
    </style>
</head>
<body>
    <main class="resume">
        <header class="header">
            <h1>{{ basics.name }}</h1>
            {% if basics.label %}<div class="headline">{{ basics.label }}</div>{% endif %}
            <div class="contact">
                {% for item in contacts %}
                <span class="contact-item">{% if item.kind == 'email' %}<a href="mailto:{{ item.label }}">{{ item.label }}</a>{% elif item.url %}<a href="{{ item.url }}">{{ item.label }}</a>{% else %}{{ item.label }}{% endif %}</span>
                {% endfor %}
            </div>
        </header>

        <section>
            <h2>Professional Profile</h2>
            <p class="summary">{{ basics.summary }}</p>
        </section>

        <section>
            <h2>Professional Experience</h2>
            {% for w in work %}
            <article class="entry{% if w.highlights | length <= 3 %} compact-entry{% endif %}">
                <div class="entry-header">
                    <div class="entry-heading">
                        <span class="entry-title">{{ w.position }}</span><span class="entry-company">{{ w.name }}</span>
                    </div>
                    <div class="entry-meta">{{ w.location }}{% if w.location %} | {% endif %}{{ w.startDate | format_date }} - {{ w.endDate | default('Present', true) | format_date }}</div>
                </div>
                {% if w.summary %}<p class="role-summary">{{ w.summary }}</p>{% endif %}
                {% if w.highlights %}
                <ul>
                    {% for highlight in w.highlights %}<li>{{ highlight }}</li>{% endfor %}
                </ul>
                {% endif %}
            </article>
            {% endfor %}
        </section>

        {% if projects %}
        <section class="systems">
            <h2>Selected Systems & Technical Depth</h2>
            {% for project in projects %}
            <article class="project">
                <div class="project-header">
                    <div><span class="project-name">{{ project.name }}</span><span class="project-company">{{ project.company }}</span></div>
                    <div class="project-meta">{{ project.startDate | format_date }} - {{ project.endDate | format_date }}</div>
                </div>
                {% if project.description %}<p class="project-summary">{{ project.description }}</p>{% endif %}
                {% if project.keywords %}<div class="tags">{% for keyword in project.keywords %}<span class="tag">{{ keyword }}</span>{% endfor %}</div>{% endif %}
                <ul>
                    {% for highlight in project.highlights %}<li>{{ highlight }}</li>{% endfor %}
                </ul>
            </article>
            {% endfor %}
        </section>
        {% endif %}

        {% if skills %}
        <section class="expertise">
            <h2>Technical Expertise</h2>
            {% for skill in skills %}
            <p class="skill-row"><span class="skill-name">{{ skill.name }}</span><span>{{ skill.keywords | join(', ') }}</span></p>
            {% endfor %}
        </section>
        {% endif %}

        {% if education %}
        <section>
            <h2>Education & Research</h2>
            {% for edu in education %}
            <article class="education">
                <div class="education-header">
                    <div><span class="education-main">{% if edu.studyType == 'Master' %}M.S.{% elif edu.studyType == 'Bachelor' %}B.S.{% else %}{{ edu.studyType }}{% endif %} in {{ edu.area }}</span><span class="detail">, {{ edu.institution }}{% if edu.score %} - GPA {{ edu.score }}{% endif %}</span></div>
                    <div class="entry-meta">{{ edu.startDate | format_date }} - {{ edu.endDate | format_date }}</div>
                </div>
                {% if edu.highlights %}<ul>{% for highlight in edu.highlights %}<li>{{ highlight }}</li>{% endfor %}</ul>{% endif %}
            </article>
            {% endfor %}
        </section>
        {% endif %}

        {% if awards %}
        <section class="compact-block">
            <h2>Recognition</h2>
            <ul class="recognition-list">{% for award in awards %}<li><strong>{{ award.name }}</strong>{% if award.date %} <span class="detail">({{ award.date }})</span>{% endif %}</li>{% endfor %}</ul>
        </section>
        {% endif %}

        {% if certificates %}
        <section class="compact-block">
            <h2>Certifications</h2>
            {% for cert in certificates %}
            <div class="credential">
                <div class="credential-header">
                    <div><span class="credential-main">{{ cert.name }}</span>{% if cert.issuer %}<span class="detail">, {{ cert.issuer }}</span>{% endif %}</div>
                    {% if cert.date %}<div class="entry-meta">{{ cert.date | format_date }}</div>{% endif %}
                </div>
            </div>
            {% endfor %}
        </section>
        {% endif %}

        {% if publications %}
        <section class="compact-block">
            <h2>Publications</h2>
            <ul class="publication-list">
                {% for publication in publications %}
                <li class="publication"><a class="publication-main" href="{{ publication.url }}">{{ publication.name }}</a>{% if publication.publisher %}<span class="detail"> - {{ publication.publisher }}</span>{% endif %}{% if publication.summary %}<span class="detail">. {{ publication.summary }}</span>{% endif %}</li>
                {% endfor %}
            </ul>
        </section>
        {% endif %}
    </main>
</body>
</html>

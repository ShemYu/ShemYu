<!DOCTYPE html>
<html lang="{{ language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ basics.name }} - {{ ui.doc_title }}</title>
    <style>
        :root {
            --page-width: 210mm;
            --page-height: 297mm;
            --ink: #14202b;
            --muted: #52606d;
            --accent: #173f5f;
            --rule: #c9d2da;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
        }

        body {
            background: #e7ebee;
            color: var(--ink);
            font-family: Arial, Helvetica, "Hiragino Sans", "Noto Sans JP", sans-serif;
            font-size: {% if language == 'ja' %}8.75pt{% else %}10.5pt{% endif %};
            line-height: {% if language == 'ja' %}1.24{% else %}1.34{% endif %};
            -webkit-font-smoothing: antialiased;
        }

        .resume {
            width: var(--page-width);
            min-height: var(--page-height);
            margin: 12px auto;
            padding: {% if language == 'ja' %}9mm 13mm 8mm{% else %}10.5mm 14mm 9.5mm{% endif %};
            background: #fff;
            box-shadow: 0 2px 12px rgba(20, 32, 43, 0.16);
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .doc-bar {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2mm;
            color: var(--muted);
            font-size: 8pt;
        }

        .doc-title {
            color: var(--accent);
            font-weight: 700;
            letter-spacing: 0.12em;
        }

        .header {
            padding-bottom: 3.2mm;
            border-bottom: 1.4pt solid var(--accent);
        }

        h1 {
            margin: 0;
            color: var(--accent);
            font-size: {% if language == 'ja' %}19pt{% else %}27pt{% endif %};
            line-height: 1;
            letter-spacing: -0.015em;
        }

        .headline {
            margin-top: 1.4mm;
            font-size: 11.5pt;
            font-weight: 700;
            letter-spacing: 0.01em;
        }

        .contact {
            display: flex;
            flex-wrap: wrap;
            margin-top: 1.8mm;
            color: var(--muted);
            font-size: 8.7pt;
        }

        .contact-item + .contact-item::before {
            content: " | ";
            padding: 0 1.2mm;
            color: #8a96a0;
        }

        section {
            margin-top: {% if language == 'ja' %}2.35mm{% else %}3.4mm{% endif %};
        }

        h2 {
            margin: 0 0 {% if language == 'ja' %}1.35mm{% else %}1.55mm{% endif %};
            color: var(--accent);
            font-size: {% if language == 'ja' %}9.2pt{% else %}9.5pt{% endif %};
            line-height: 1.1;
            letter-spacing: {% if language == 'ja' %}0.06em{% else %}0.12em{% endif %};
            text-transform: {% if language == 'ja' %}none{% else %}uppercase{% endif %};
        }

        p {
            margin: 0;
        }

        .summary {
            max-width: 178mm;
            color: #273746;
        }

        .entry {
            margin-bottom: {% if language == 'ja' %}1.65mm{% else %}2.4mm{% endif %};
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .entry:last-child {
            margin-bottom: 0;
        }

        .entry-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 5mm;
        }

        .entry-heading {
            min-width: 0;
            font-size: {% if language == 'ja' %}9.7pt{% else %}10.2pt{% endif %};
            line-height: 1.15;
        }

        .entry-title {
            font-weight: 700;
        }

        .entry-company::before {
            content: " | ";
            padding: 0 0.7mm;
            color: #83909a;
            font-weight: 400;
        }

        .entry-company {
            color: #344a5d;
            font-weight: 600;
        }

        .entry-date {
            flex: 0 0 auto;
            color: var(--muted);
            font-size: 8.7pt;
            white-space: nowrap;
        }

        .role-summary {
            margin-top: 0.55mm;
            color: #465767;
            font-size: 9.2pt;
            font-style: italic;
        }

        ul {
            margin: {% if language == 'ja' %}0.75mm{% else %}0.9mm{% endif %} 0 0;
            padding-left: 4.2mm;
        }

        li {
            margin-bottom: {% if language == 'ja' %}0.3mm{% else %}0.6mm{% endif %};
            padding-left: 0.45mm;
        }

        li::marker {
            color: var(--accent);
        }

        li:last-child {
            margin-bottom: 0;
        }

        .skill-row {
            display: grid;
            grid-template-columns: 34mm 1fr;
            column-gap: 2mm;
            margin-bottom: 0.65mm;
            font-size: {% if language == 'ja' %}8.75pt{% else %}9.2pt{% endif %};
        }

        .skill-row:last-child {
            margin-bottom: 0;
        }

        .skill-name {
            color: #344a5d;
            font-weight: 700;
        }

        .education-row,
        .credential-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 5mm;
            margin-bottom: 0.65mm;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .education-row:last-child,
        .credential-row:last-child {
            margin-bottom: 0;
        }

        .education-main,
        .credential-main,
        .credential-label {
            font-weight: 700;
        }

        .education-detail,
        .credential-detail {
            color: #3e4f5e;
            font-weight: 400;
        }

        .recognition {
            margin-top: 0.65mm;
        }

        @media print {
            @page {
                size: A4;
                margin: 0;
            }

            body {
                background: #fff;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .resume {
                width: var(--page-width);
                min-height: var(--page-height);
                margin: 0;
                box-shadow: none;
            }
        }
    </style>
</head>
<body>
    <main class="resume">
        {% if language == 'ja' %}
        <div class="doc-bar">
            <div class="doc-title">{{ ui.doc_title }}</div>
            <div>{{ as_of }}</div>
        </div>
        {% endif %}

        <header class="header">
            <h1>{{ basics.name }}</h1>
            {% if basics.label %}<div class="headline">{{ basics.label }}</div>{% endif %}
            <div class="contact">
                {% if contacts is defined and contacts %}
                    {% for item in contacts %}
                    <span class="contact-item">{% if item.kind == 'email' %}<a href="mailto:{{ item.label }}">{{ item.label }}</a>{% elif item.url %}<a href="{{ item.url }}">{{ item.label }}</a>{% else %}{{ item.label }}{% endif %}</span>
                    {% endfor %}
                {% else %}
                    {% if basics.email %}<span class="contact-item"><a href="mailto:{{ basics.email }}">{{ basics.email }}</a></span>{% endif %}
                    {% if basics.phone %}<span class="contact-item">{{ basics.phone }}</span>{% endif %}
                    {% if basics.location.city %}<span class="contact-item">{{ basics.location.city }}{% if basics.location.region %}, {{ basics.location.region }}{% endif %}</span>{% endif %}
                    {% if basics.url %}<span class="contact-item"><a href="{{ basics.url }}">{{ basics.url | replace('https://', '') | replace('http://', '') }}</a></span>{% endif %}
                {% endif %}
            </div>
        </header>

        {% if basics.summary %}
        <section>
            <h2>{{ ui.summary }}</h2>
            <p class="summary">{{ basics.summary }}</p>
        </section>
        {% endif %}

        {% if work %}
        <section>
            <h2>{{ ui.experience }}</h2>
            {% for w in work %}
            <article class="entry">
                <div class="entry-header">
                    <div class="entry-heading">
                        <span class="entry-title">{{ w.position }}</span><span class="entry-company">{{ w.name }}</span>
                    </div>
                    <div class="entry-date">{{ w.startDate | format_date }} - {{ w.endDate | default(ui.present, true) | format_date }}</div>
                </div>
                {% if w.summary %}<p class="role-summary">{{ w.summary }}</p>{% endif %}
                {% if w.highlights %}
                <ul>
                    {% for highlight in w.highlights %}
                    <li>{% if language == 'ja' and w.highlight_axes is defined and w.highlight_axes[loop.index0] %}<strong>{{ w.highlight_axes[loop.index0] }}</strong> {% endif %}{{ highlight }}</li>
                    {% endfor %}
                </ul>
                {% endif %}
            </article>
            {% endfor %}
        </section>
        {% endif %}

        {% if skills %}
        <section>
            <h2>{{ ui.skills }}</h2>
            {% for skill in skills %}
            <p class="skill-row"><span class="skill-name">{{ skill.name }}</span><span>{{ skill.keywords | join(', ') }}</span></p>
            {% endfor %}
        </section>
        {% endif %}

        {% if education or certificates or awards %}
        <section>
            <h2>{{ ui.credentials }}</h2>
            {% for edu in education %}
            <div class="education-row">
                <div>
                    {% if language == 'ja' %}
                    <span class="education-main">{{ edu.studyType }}（{{ edu.area }}）</span><span class="education-detail">, {{ edu.institution }}{% if edu.score %} - {{ ui.gpa }} {{ edu.score }}{% endif %}</span>
                    {% else %}
                    <span class="education-main">{% if edu.studyType == 'Master' %}M.S.{% elif edu.studyType == 'Bachelor' %}B.S.{% else %}{{ edu.studyType }}{% endif %} in {{ edu.area }}</span><span class="education-detail">, {{ edu.institution }}{% if edu.score %} - GPA {{ edu.score }}{% endif %}</span>
                    {% endif %}
                </div>
                <div class="entry-date">{{ edu.startDate | format_date }} - {{ edu.endDate | format_date }}</div>
            </div>
            {% endfor %}
            {% for cert in certificates %}
            <div class="credential-row">
                <div><span class="credential-main">{{ cert.name }}</span>{% if cert.issuer %}<span class="credential-detail">, {{ cert.issuer }}</span>{% endif %}</div>
                {% if cert.date %}<div class="entry-date">{{ cert.date | format_date }}</div>{% endif %}
            </div>
            {% endfor %}
            {% if awards %}
            <p class="recognition"><span class="credential-label">{{ ui.recognition }}:</span> {{ awards | map(attribute='name') | join('; ') }}</p>
            {% endif %}
        </section>
        {% endif %}
    </main>
</body>
</html>

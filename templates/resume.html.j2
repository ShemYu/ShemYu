<!DOCTYPE html>
<html lang="{{ language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ basics.name }} - {{ ui.doc_title }}</title>
    <style>
        :root {
            --page-width: 210mm;
            --page-height: 297mm;
            --text: #111;
            --muted: #444;
            --rule: #222;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
        }

        body {
            background: #e9e9e9;
            color: var(--text);
            font-family: Helvetica, Arial, "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Noto Sans JP", "Noto Sans CJK JP", "WenQuanYi Micro Hei", Meiryo, sans-serif;
            font-size: {% if language == 'ja' %}9.2pt{% else %}10pt{% endif %};
            line-height: {% if language == 'ja' %}1.22{% else %}1.28{% endif %};
        }

        .resume {
            width: var(--page-width);
            min-height: var(--page-height);
            margin: 12px auto;
            padding: {% if language == 'ja' %}10mm 14mm 9mm{% else %}13mm 16mm 12mm{% endif %};
            background: #fff;
            box-shadow: 0 1px 8px rgba(0, 0, 0, 0.16);
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .header {
            text-align: center;
            margin-bottom: {% if language == 'ja' %}2.2mm{% else %}3.5mm{% endif %};
        }

        h1 {
            margin: 0;
            font-size: {% if language == 'ja' %}18pt{% else %}24pt{% endif %};
            line-height: 1.05;
            letter-spacing: 0.01em;
        }

        .headline {
            margin-top: 1.2mm;
            font-size: 11pt;
            font-weight: 700;
        }

        .contact {
            margin-top: 1.8mm;
            color: var(--muted);
            font-size: 9pt;
        }

        .contact span + span::before {
            content: " | ";
            padding: 0 1.2mm;
            color: #777;
        }

        section {
            margin-top: {% if language == 'ja' %}2.2mm{% else %}3.2mm{% endif %};
        }

        h2 {
            margin: 0 0 1.7mm;
            padding-bottom: 0.7mm;
            border-bottom: 0.8pt solid var(--rule);
            font-size: 10.5pt;
            line-height: 1.1;
            letter-spacing: {% if language == 'ja' %}0.04em{% else %}0.06em{% endif %};
            text-transform: {% if language == 'ja' %}none{% else %}uppercase{% endif %};
        }

        .doc-bar {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 2.2mm;
            color: var(--muted);
            font-size: 9pt;
        }

        .doc-title {
            color: var(--text);
            font-weight: 700;
            letter-spacing: 0.12em;
        }

        p {
            margin: 0;
        }

        .summary {
            color: #222;
        }

        .role-summary {
            margin-top: 0.6mm;
            font-size: 9.3pt;
        }

        .skill-row {
            margin-bottom: 0.7mm;
            font-size: 9.2pt;
        }

        .skill-row:last-child {
            margin-bottom: 0;
        }

        .skill-name {
            font-weight: 700;
        }

        .entry {
            margin-bottom: {% if language == 'ja' %}1.8mm{% else %}2.7mm{% endif %};
            {% if language != 'ja' %}
            break-inside: avoid;
            page-break-inside: avoid;
            {% endif %}
        }

        .entry:last-child {
            margin-bottom: 0;
        }

        .entry-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 6mm;
        }

        .entry-title {
            font-size: 10pt;
            font-weight: 700;
        }

        .entry-date {
            flex: 0 0 auto;
            color: var(--muted);
            font-size: 9pt;
            white-space: nowrap;
        }

        .entry-subtitle {
            margin-top: 0.3mm;
            color: #333;
            font-size: 9.4pt;
            font-weight: 600;
        }

        ul {
            margin: 1mm 0 0;
            padding-left: 4.5mm;
        }

        li {
            margin-bottom: {% if language == 'ja' %}0.4mm{% else %}0.7mm{% endif %};
            padding-left: 0.5mm;
        }

        li:last-child {
            margin-bottom: 0;
        }

        .education-row,
        .certificate-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 6mm;
            margin-bottom: 1mm;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .education-row:last-child,
        .certificate-row:last-child {
            margin-bottom: 0;
        }

        .education-main,
        .certificate-main {
            font-weight: 700;
        }

        .education-detail {
            color: #333;
            font-weight: 400;
        }

        @media print {
            @page {
                size: A4;
                margin: 0;
            }

            body {
                background: #fff;
            }

            .resume {
                width: var(--page-width);
                min-height: var(--page-height);
                margin: 0;
                box-shadow: none;
            }
        }
    </style>
</head>
<body>
    <main class="resume">
        {% if language == 'ja' %}
        <div class="doc-bar">
            <div class="doc-title">{{ ui.doc_title }}</div>
            <div>{{ as_of }}</div>
        </div>
        {% endif %}
        <header class="header">
            <h1>{{ basics.name }}</h1>
            <div class="headline">{{ basics.label }}</div>
            <div class="contact">
                {% if basics.email %}<span><a href="mailto:{{ basics.email }}">{{ basics.email }}</a></span>{% endif %}
                {% if basics.phone %}<span>{{ basics.phone }}</span>{% endif %}
                {% if basics.location.city %}<span>{{ basics.location.city }}, {{ basics.location.region }}</span>{% endif %}
                {% if basics.url %}<span><a href="{{ basics.url }}">{{ basics.url | replace('https://', '') | replace('http://', '') }}</a></span>{% endif %}
                {% if language == 'ja' %}
                    {% for profile in basics.profiles if profile.network == 'LinkedIn' and profile.url %}
                    <span><a href="{{ profile.url }}">LinkedIn</a></span>
                    {% endfor %}
                {% endif %}
            </div>
        </header>

        {% if basics.summary %}
        <section>
            <h2>{{ ui.summary }}</h2>
            <p class="summary">{{ basics.summary }}</p>
        </section>
        {% endif %}

        {% if skills %}
        <section>
            <h2>{{ ui.skills }}</h2>
            {% for skill in skills if skill.name not in ['Language', 'Leadership & Communication', '語学', 'リーダーシップ / コミュニケーション'] %}
            <p class="skill-row"><span class="skill-name">{{ skill.name }}:</span> {{ skill.keywords[:7] | join(', ') }}</p>
            {% endfor %}
            {% for skill in skills if skill.name in ['Language', '語学'] %}
            <p class="skill-row"><span class="skill-name">{{ ui.languages }}:</span> {{ skill.keywords | join(', ') }}</p>
            {% endfor %}
        </section>
        {% endif %}

        {% if work %}
        <section>
            <h2>{{ ui.experience }}</h2>
            {% for w in work[:3] %}
            {% set role_index = loop.index0 %}
            <article class="entry">
                <div class="entry-header">
                    <div class="entry-title">{% if language == 'ja' %}{{ w.name }}{% else %}{{ w.position }}{% endif %}</div>
                    <div class="entry-date">{{ w.startDate | format_date }} - {{ w.endDate | default('Present', true) | format_date }}</div>
                </div>
                <div class="entry-subtitle">{% if language == 'ja' %}{{ w.position }}{% if w.location %} · {{ w.location }}{% endif %}{% else %}{{ w.name }}{% endif %}</div>
                {% if language == 'ja' and w.summary %}
                <p class="role-summary">{{ w.summary }}</p>
                {% endif %}
                {% if w.highlights %}
                <ul>
                    {% for highlight in w.highlights[:highlight_caps[role_index]] %}
                    <li>{% if language == 'ja' and w.highlight_axes is defined and w.highlight_axes[loop.index0] %}<strong>{{ w.highlight_axes[loop.index0] }}</strong> {% endif %}{{ highlight }}</li>
                    {% endfor %}
                </ul>
                {% endif %}
            </article>
            {% endfor %}
        </section>
        {% endif %}

        {% if education %}
        <section>
            <h2>{{ ui.education }}</h2>
            {% for edu in education[:education_limit] %}
            <div class="education-row">
                <div>
                    {% if language == 'ja' %}
                    <span class="education-main">{{ edu.studyType }}（{{ edu.area }}）</span><span class="education-detail">, {{ edu.institution }}{% if edu.score %} - {{ ui.gpa }} {{ edu.score }}{% endif %}</span>
                    {% else %}
                    <span class="education-main">{{ edu.studyType }} in {{ edu.area }}</span><span class="education-detail">, {{ edu.institution }}{% if edu.score %} - GPA {{ edu.score }}{% endif %}</span>
                    {% endif %}
                </div>
                <div class="entry-date">{{ edu.startDate | format_date }} - {{ edu.endDate | format_date }}</div>
            </div>
            {% endfor %}
        </section>
        {% endif %}

        {% if certificates %}
        <section>
            <h2>{{ ui.certificates }}</h2>
            {% for cert in certificates if 'Cloud Quest' not in cert.name %}
            <div class="certificate-row">
                <div><span class="certificate-main">{{ cert.name }}</span>{% if cert.issuer %}, {{ cert.issuer }}{% endif %}</div>
                {% if cert.date %}<div class="entry-date">{{ cert.date | format_date }}</div>{% endif %}
            </div>
            {% endfor %}
        </section>
        {% endif %}
    </main>
</body>
</html>
